{
  "$schema": "./node_modules/@openapitools/openapi-generator-cli/config.schema.json",
  "spaces": 2,
  "generator-cli": {
    "version": "7.26.0",
    "generators": {
      "dart-sdk": {
        "generatorName": "dart-dio",
        "inputSpec": "spec/openapi-3.0.json",
        "output": "packages/dart",
        "additionalProperties": {
          "pubName": "shukka_sdk",
          "pubVersion": "0.1.0",
          "pubDescription": "Dart client for the Shukka release API, generated from the OpenAPI contract",
          "pubAuthor": "shukka-app",
          "pubHomepage": "https://github.com/shukka-app/sdk",
          "pubRepository": "https://github.com/shukka-app/sdk",
          "pubLibrary": "shukka_sdk.api",
          "serializationLibrary": "json_serializable",
          "dateLibrary": "core",
          "enumUnknownDefaultCase": true
        }
      }
    }
  }
}
